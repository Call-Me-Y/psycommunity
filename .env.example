# Copy this file to .env, then replace the sample values before using Docker Compose.
DB_NAME=psycommunity
DB_USER=psycommunity
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:8088

# Optional. When both values are set, the first admin account is created on first startup.
BOOTSTRAP_ADMIN_UID=
BOOTSTRAP_ADMIN_PASSWORD=

# OpenAI-compatible chat-completions endpoint and credentials.
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=

# Directory containing model.onnx and tokenizer.json; download it before enabling.
EMOTION_MODEL_ENABLED=false
EMOTION_MODEL_PATH=./models/emotion
EMOTION_ALERT_THRESHOLD=0.80
